rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global security primitives
    function isSignedIn() {
      return request.auth != null;
    }

    // Designates naren9239@gmail.com or admin token as administrator with full access
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'naren9239@gmail.com' ||
        (request.auth.token.admin == true)
      );
    }

    function isOwner(userId) {
      return isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Health and connection probe document
    match /test/{document=**} {
      allow read, write: if true;
    }

    // User Profile validation
    function isValidUser(data, userId) {
      return (data.uid == userId || isAdmin())
        && (!('monthlyBaseIncome' in data) || data.monthlyBaseIncome is number)
        && (!('email' in data) || (data.email is string && data.email.size() <= 256));
    }

    // Transaction validation
    function isValidTransaction(data, userId) {
      return (data.userId == userId || isAdmin())
        && (!('merchant' in data) || (data.merchant is string && data.merchant.size() <= 256))
        && (!('amount' in data) || data.amount is number)
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000));
    }

    // Payment Card validation
    function isValidCard(data, userId) {
      return (data.userId == userId || isAdmin())
        && (!('bankName' in data) || (data.bankName is string && data.bankName.size() <= 128))
        && (!('type' in data) || data.type in ['credit', 'debit']);
    }

    // Budget validation
    function isValidBudget(data, userId) {
      return (data.userId == userId || isAdmin())
        && (!('category' in data) || (data.category is string && data.category.size() <= 128));
    }

    // Chat Message validation
    function isValidChatMessage(data, userId) {
      return (data.userId == userId || isAdmin())
        && (!('role' in data) || data.role in ['user', 'assistant'])
        && (!('text' in data) || (data.text is string && data.text.size() <= 30000));
    }

    // User document path
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isSignedIn(); // Allow listing users for console and dashboard exploration
      allow create, update: if isOwner(userId) && isValidUser(incoming(), userId);
      allow delete: if isOwner(userId) || isAdmin();

      // Messages subcollection for Aura AI Assistant
      match /messages/{messageId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidChatMessage(incoming(), userId);
        allow delete: if isOwner(userId);
      }

      // Transactions subcollection
      match /transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidTransaction(incoming(), userId);
        allow delete: if isOwner(userId);
      }

      // Cards subcollection
      match /cards/{cardId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidCard(incoming(), userId);
        allow delete: if isOwner(userId);
      }

      // Budgets subcollection
      match /budgets/{budgetId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidBudget(incoming(), userId);
        allow delete: if isOwner(userId);
      }
    }

    // Root-level collections for direct browsing & console viewing/editing
    match /transactions/{transactionId} {
      allow read, write: if isSignedIn();
    }

    match /cards/{cardId} {
      allow read, write: if isSignedIn();
    }

    match /budgets/{budgetId} {
      allow read, write: if isSignedIn();
    }

    match /messages/{messageId} {
      allow read, write: if isSignedIn();
    }

    // Global admin override: Allows naren9239@gmail.com full read & write across any collection
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
